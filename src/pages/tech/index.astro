---
import { getCollection, type CollectionEntry } from "astro:content";
import "../../styles/global.css";
import PageLayout from "../../layouts/PageLayout.astro";
import PostCard from "../../components/PostCard.astro";


const posts = (await getCollection("tech")).sort(
  (a: CollectionEntry<"tech">, b: CollectionEntry<"tech">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const isEmpty = posts.length === 0;
---

<PageLayout>
  <h1>tech</h1>
  <!-- <p>
    these are not very polished or anything, just a collection of my thoughts
    that i can put in my little corner of the internet.
  </p> -->
  <ul class="post-list">
    {
      isEmpty ? (
        <li class="post-list-item">
          <p>nothing here yet :P</p>
        </li>
      ) : (
        posts.map((post) => (
          <li class="post-list-item">
            <PostCard post={post} />
          </li>
        ))
      )
    }
  </ul>
</PageLayout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  ul li {
    width: 100%;
  }
  ul li * {
    text-decoration: none;
  }
  ul li::before {
    content: "";
    margin-bottom: 1rem;
    display: block;
    width: 100%;
    height: 1px;
    background-color: grey;
  }

  ul li a {
    color: var(--white);
  }
  .post-header {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    margin: 0;
    line-height: 1;
  }
  .date {
    margin: 0;
    color: rgb(var(--gray));
  }
  ul li a:hover {
    color: var(--accent);
    /* border: 2px solid var(--accent-dark); */
  }

  ,
  @media (max-width: 720px) {
    ul {
      gap: 0.5em;
    }
    ul li {
      width: 100%;
      text-align: center;
    }
    ul li:first-child {
      margin-bottom: 0;
    }
    ul li:first-child .title {
      font-size: 1.563em;
    }
  }
</style>
