---
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import logo from "../assets/site-logo.png";
import rssIcon from "../assets/rss.svg";
---

<header>
  <nav>
    <a class="logo" href="/">
      <Image src={logo} alt="site logo" width={50} height={50} />
    </a>
    <div class="internal-links">
      <HeaderLink href="/">home</HeaderLink>
      <div class="nav-item">
        <HeaderLink href="/art">art</HeaderLink>
        <div class="submenu">
          <HeaderLink href="/art/photography">photography</HeaderLink>
          <HeaderLink href="/art/illustration">illustration</HeaderLink>
        </div>
      </div>
      <HeaderLink href="/tech">tech</HeaderLink>
    </div>
  </nav>
</header>
<style>
  header {
    margin: 1em 0;
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    margin: 0 auto;
    justify-content: space-between;
    width: 980px;
  }
  nav a {
    width: 100px;
    height: 50px;
    color: var(--white);
    text-decoration: none;
    text-align: center;
    align-content: center;
  }
  nav a.active {
    text-decoration: none;
    border: 2px solid var(--accent);
  }

  .logo {
    border: none;
  }
  .internal-links {
    display: flex;
    align-items: center;
  }
  .nav-item {
    position: relative;
  }
  .submenu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-width: 150px;
    padding: 0.5rem 1rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.25rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }
  .nav-item:hover .submenu,
  .nav-item:focus-within .submenu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .submenu :global(a) {
    padding: 0 1rem;
    background: var(--black);
  }
  .internal-links img {
    filter: brightness(0) invert(1);
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  @media (max-width: 780px) {
    nav {
      width: 100%;
      flex-direction: column;
      align-items: center;
    }

    .logo {
      margin-bottom: 2em;
    }

    .internal-links {
      padding: 0 1em;
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1em;
    }

    .social-links {
      display: none;
    }
  }
</style>
